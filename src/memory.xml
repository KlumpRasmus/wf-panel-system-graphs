<?xml version="1.0"?>
<wf-panel-pi>
  <plugin name="panel">
    <_short>Panel</_short>
    <group>
      <_short>Memory</_short>
      <option name="memory_show_percentage" type="bool">
        <_short>Memory Show Percentage</_short>
        <default>true</default>
      </option>
      <option name="memory_foreground" type="string">
        <_short>Memory Foreground</_short>
        <default>#53c86b</default>
      </option>
      <option name="memory_background" type="string">
        <_short>Memory Background</_short>
        <default>rgba(64,64,64,0.55)</default>
      </option>
    </group>
  </plugin>
</wf-panel-pi>
