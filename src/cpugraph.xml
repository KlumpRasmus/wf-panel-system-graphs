<?xml version="1.0"?>
<wf-panel-pi>
  <plugin name="panel">
    <_short>Panel</_short>
    <group>
      <_short>CPU Custom</_short>
      <option name="cpugraph_show_percentage" type="bool">
        <_short>CPU Custom Show Percentage</_short>
        <default>true</default>
      </option>
      <option name="cpugraph_foreground" type="string">
        <_short>CPU Custom Foreground</_short>
        <default>#53c86b</default>
      </option>
      <option name="cpugraph_background" type="string">
        <_short>CPU Custom Background</_short>
        <default>rgba(64,64,64,0.55)</default>
      </option>
    </group>
  </plugin>
</wf-panel-pi>
